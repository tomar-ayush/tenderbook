# Set these in Vercel: Project, Settings, Environment Variables. For a local run, copy to .env.
# The read-only login printed by db/create-web-role.sh on the VM (never the owner's URL)
DATABASE_URL=postgresql://tenderbook_web:PASSWORD@VM_ADDRESS:5433/gem
# The two labels of the stored contract list that hold its total and its status (ask the pipeline owner).
# Without them, a won bid's value is its offered price instead of its contract total.
CONTRACT_TOTAL_FIELD=
CONTRACT_STATUS_FIELD=
# Optional: the server's certificate (PEM) to verify it; without it the connection is encrypted but not verified
PG_CA_CERT=
